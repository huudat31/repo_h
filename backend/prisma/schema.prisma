datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  VNPAY
  MOMO
  COD
}

enum ShippingCarrier {
  GHN
  GHTK
}

model User {
  id        String          @id @default(uuid())
  email     String          @unique
  password  String
  fullName  String
  phone     String?
  role      Role            @default(CUSTOMER)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  orders    Order[]
  addresses Address[]
  reviews   ProductReview[]

  @@map("users")
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  recipientName String
  phone         String
  provinceName  String
  provinceId    Int
  districtName  String
  districtId    Int
  wardName      String
  wardCode      String
  detailAddress String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  origin    String?   // Xuất xứ: Nhật Bản, Hà Lan, Việt Nam...
  products  Product[]
  createdAt DateTime  @default(now())

  @@map("brands")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}

model Product {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  sku              String           @unique
  shortDescription String?
  description      String?
  price            Float
  originalPrice    Float?
  stock            Int              @default(0)
  images           String[]
  isPublished      Boolean          @default(true)
  // Lưu trữ thuộc tính kỹ thuật linh hoạt: công suất, dung tích, inverter, kích thước...
  specs            Json?            @default("{}")
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  warrantyMonths   Int              @default(12) // Thời gian bảo hành tiêu chuẩn (tháng)
  media360Urls     String[]         @default([]) // Danh sách frame ảnh quay 360 độ
  videoUrl         String?          // Video trải nghiệm thực tế
  crossSellIds     String[]         @default([]) // ID các sản phẩm/phụ kiện gợi ý mua kèm
  variants         ProductVariant[]
  orderItems       OrderItem[]
  reviews          ProductReview[]
  warrantyRecords  WarrantyRecord[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // Màu sắc, Dung tích (5L/8L), Công suất (1.0HP/1.5HP)
  sku       String   @unique
  price     Float
  stock     Int      @default(0)
  specs     Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_variants")
}

model ProductReview {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int      @default(5) // 1 - 5 sao
  comment    String
  images     String[] @default([]) // Ảnh thực tế từ người mua
  isVerified Boolean  @default(true) // Xác nhận đã mua hàng
  createdAt  DateTime @default(now())

  @@index([productId])
  @@map("product_reviews")
}

model ServiceAddon {
  id          String   @id @default(uuid())
  name        String   // Dịch vụ lắp đặt tận nơi, Gói bảo hành mở rộng 24 tháng
  code        String   @unique
  price       Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("service_addons")
}

model Voucher {
  id            String    @id @default(uuid())
  code          String    @unique
  title         String
  discountType  String    // 'PERCENT' | 'FIXED'
  discountValue Float
  minOrderValue Float     @default(0)
  maxDiscount   Float?
  usageLimit    Int       @default(100)
  usedCount     Int       @default(0)
  validFrom     DateTime  @default(now())
  validTo       DateTime
  isActive      Boolean   @default(true)

  @@map("vouchers")
}

model WarrantyRecord {
  id            String    @id @default(uuid())
  serialNumber  String    @unique // Mã Serial / IMEI dán trên máy
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  orderId       String?
  customerPhone String
  customerName  String
  startDate     DateTime  @default(now())
  endDate       DateTime
  status        String    @default("ACTIVE") // ACTIVE | EXPIRED | REPAIRING

  @@index([customerPhone])
  @@index([serialNumber])
  @@map("warranty_records")
}

model Order {
  id                   String               @id @default(uuid())
  orderCode            String               @unique
  userId               String?
  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipientName        String
  recipientPhone       String
  shippingAddress      Json
  totalAmount          Float
  shippingFee          Float                @default(0)
  discountAmount       Float                @default(0)
  addonAmount          Float                @default(0) // Phí dịch vụ đi kèm
  finalAmount          Float
  selectedAddons       Json?                @default("[]") // Danh sách dịch vụ đi kèm đã chọn
  voucherCode          String?
  status               OrderStatus          @default(PENDING)
  paymentProvider      PaymentProvider      @default(COD)
  paymentStatus        PaymentStatus        @default(PENDING)
  shippingCarrier      ShippingCarrier?
  shippingTrackingCode String?
  notes                String?
  items                OrderItem[]
  payments             PaymentTransaction[]
  shippingOrders       ShippingOrder[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([orderCode])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  price       Float
  quantity    Int
  specs       Json?    @default("{}")
  createdAt   DateTime @default(now())

  @@map("order_items")
}

model PaymentTransaction {
  id            String          @id @default(uuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      PaymentProvider
  transactionNo String?
  amount        Float
  status        PaymentStatus   @default(PENDING)
  bankCode      String?
  responseCode  String?
  payload       Json?
  createdAt     DateTime        @default(now())

  @@index([orderId])
  @@map("payment_transactions")
}

model ShippingOrder {
  id                 String          @id @default(uuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier            ShippingCarrier
  trackingCode       String?         @unique
  fee                Float
  expectedDeliveryAt DateTime?
  status             String          @default("CREATED")
  rawResponse        Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("shipping_orders")
}
