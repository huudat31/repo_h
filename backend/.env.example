# ==========================================
# TechStore VN - Backend Environment Configuration
# ==========================================

# 1. Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=ecommerce_db
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/ecommerce_db?schema=public"

# 2. Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 3. Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# 4. Backend Service Config
PORT=5000
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# 5. Frontend Client URLs
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 6. Payment Gateways (Vietnam)
# VNPAY Sandbox (Get credentials from sandbox.vnpayment.vn)
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return

# MoMo Sandbox (Get credentials from developers.momo.vn)
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/checkout/success
MOMO_IPN_URL=http://localhost:5000/api/payments/momo/ipn

# 7. Shipping Carriers (Vietnam)
# GHN (Giao Hàng Nhanh - api.ghn.vn)
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_API_TOKEN=your_ghn_api_token
GHN_SHOP_ID=123456

# GHTK (Giao Hàng Tiết Kiệm)
GHTK_API_URL=https://services.giaohangtietkiem.vn/services/shipment
GHTK_API_TOKEN=your_ghtk_api_token

# 8. Email Notifications (Nodemailer / SMTP)
MAIL_DRIVER=nodemailer
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="TechStore VN <noreply@techstore.vn>"

# SendGrid (Optional)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
