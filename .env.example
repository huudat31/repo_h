# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=ecommerce_db
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/ecommerce_db?schema=public"

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# Backend Config
PORT=5000
JWT_SECRET=super-secret-jwt-key-2026-ecommerce
JWT_EXPIRES_IN=7d

# Frontend Config
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment Gateways (Vietnam)
# VNPAY Sandbox
VNPAY_TMN_CODE=DEMO2026
VNPAY_HASH_SECRET=DEMOHASHSECRETKEY2026XYZ
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/checkout/success

# MoMo Sandbox
MOMO_PARTNER_CODE=MOMO_DEMO
MOMO_ACCESS_KEY=MOMO_ACCESS_KEY_DEMO
MOMO_SECRET_KEY=MOMO_SECRET_KEY_DEMO
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/checkout/success
MOMO_IPN_URL=http://localhost:5000/api/payments/momo/ipn

# Shipping Carriers (Vietnam)
# GHN (Giao Hàng Nhanh)
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_API_TOKEN=your_ghn_sandbox_token
GHN_SHOP_ID=123456

# GHTK (Giao Hàng Tiết Kiệm)
GHTK_API_URL=https://services.giaohangtietkiem.vn/services/shipment
GHTK_API_TOKEN=your_ghtk_sandbox_token

# Email Notifications
MAIL_DRIVER=nodemailer # nodemailer or sendgrid
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="TechStore <noreply@techstore.vn>"

# SendGrid (Optional)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
